# ===================================
# vpn-api — Environment Variables
# ===================================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/vpndb

# JWT Secret — generate dengan:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti_dengan_random_string_panjang

# Port API
PORT=3000

# CORS — URL dashboard yang boleh akses API ini
# Ganti dengan domain dashboard kamu (bisa pakai HTTPS kalau sudah SSL)
# Contoh: https://vpn.domainku.com
CORS_ORIGIN=https://dashboard.domainmu.com