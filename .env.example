# ===================================
# vpn-api — Environment Variables
# ===================================

# ── Database ──────────────────────────────────────────────────
# Konek ke container 'postgres-db' yang sudah running di Docker
# Gunakan nama container sebagai hostname (bukan localhost!)
# Format: postgresql://USER:PASSWORD@CONTAINER_NAME:PORT/DB_NAME
#
# Contoh jika postgres-db punya user 'postgres' dan db 'vpndb':
DATABASE_URL=postgresql://postgres:yourpassword@postgres-db:5432/vpndb

# ── JWT Secret ───────────────────────────────────────────────
# Generate dengan:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti_dengan_random_string_panjang_64_karakter

# ── Server ───────────────────────────────────────────────────
PORT=3000

# ── CORS ─────────────────────────────────────────────────────
# Domain dashboard yang boleh akses API ini
# Bisa isi beberapa domain dipisah koma
# Contoh: https://vpn.domainmu.com,https://www.vpn.domainmu.com
CORS_ORIGIN=https://vpn.domainmu.com